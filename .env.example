# Site
NEXT_PUBLIC_SITE_URL=https://www.nadeemrealestate.com
PORT=3000

# Chat assistant (planned — see src/components/ChatWidget.tsx)
# Server-side only; never expose to the client / NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Supabase — database, auth, storage (Must Have)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mapbox — maps + geocoding (Must Have)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Resend — inquiry email notifications (Highly Recommended)
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=contact@nadeemrealestate.com

# Algolia — instant search (Highly Recommended, optional if using Meilisearch instead)
NEXT_PUBLIC_ALGOLIA_APP_ID=
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=
ALGOLIA_ADMIN_KEY=

# Cloudinary — image hosting/optimization (Highly Recommended)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Sentry — error tracking (Highly Recommended)
NEXT_PUBLIC_SENTRY_DSN=

# Cloudflare Turnstile — spam protection on the contact form (Highly Recommended)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Clerk — agent/admin auth (Optional, only once there are multiple agents)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
